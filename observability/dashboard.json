{
  "__inputs": [
    { "name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus" },
    { "name": "DS_LOKI",       "label": "Loki",       "type": "datasource", "pluginId": "loki" },
    { "name": "DS_JAEGER",     "label": "Jaeger",     "type": "datasource", "pluginId": "jaeger" }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "datasource", "id": "loki",       "name": "Loki",       "version": "1.0.0" },
    { "type": "datasource", "id": "jaeger",     "name": "Jaeger",     "version": "1.0.0" }
  ],
  "title": "AI Training Audit",
  "uid":   "ai-training-audit",
  "tags":  ["training", "blockchain", "audit"],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 38,
  "time": { "from": "now-15m", "to": "now" },

  "templating": {
    "list": [
      {
        "name":    "session_id",
        "label":   "Session",
        "type":    "query",
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "query":   "label_values(session_id)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*"
      }
    ]
  },

  "panels": [

    {
      "id": 1,
      "type": "row",
      "title": "Training Progress",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false
    },

    {
      "id": 2,
      "title": "Training Loss",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 1, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr":    "training_loss{session_id=~\"$session_id\"}",
          "legendFormat": "loss"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "options": { "tooltip": { "mode": "single" } }
    },

    {
      "id": 3,
      "title": "Total Training Steps",
      "type": "stat",
      "gridPos": { "x": 12, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "training_steps_total{session_id=~\"$session_id\"}",
          "legendFormat": "steps"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "unit": "short"
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value" }
    },

    {
      "id": 4,
      "title": "Epoch Progress",
      "type": "stat",
      "gridPos": { "x": 16, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "expr":    "{service=\"watcher\", event=\"watcher.epoch_boundary_reached\", session_id=~\"$session_id\"} | json | unwrap epoch",
          "legendFormat": "epoch"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value_and_name" }
    },

    {
      "id": 5,
      "title": "Packet Queue Size",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 5, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr":         "watcher_packet_queue_size{session_id=~\"$session_id\"}",
          "legendFormat": "queue depth"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "orange", "mode": "fixed" },
          "custom": { "lineWidth": 2, "fillOpacity": 20 },
          "thresholds": {
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red",    "value": 50 }
            ]
          }
        }
      }
    },

    {
      "id": 10,
      "type": "row",
      "title": "Blockchain Anchoring",
      "gridPos": { "x": 0, "y": 9, "w": 24, "h": 1 },
      "collapsed": false
    },

    {
      "id": 11,
      "title": "TX Anchoring Events",
      "type": "logs",
      "gridPos": { "x": 0, "y": 10, "w": 14, "h": 8 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "expr": "{service=\"audit-controller\", event=\"packet.anchored\", session_id=~\"$session_id\"}",
          "maxLines": 100
        }
      ],
      "options": { "showTime": true, "wrapLogMessage": false, "sortOrder": "Descending" }
    },

    {
      "id": 12,
      "title": "Blockchain Anchor Failures",
      "type": "stat",
      "gridPos": { "x": 14, "y": 10, "w": 5, "h": 4 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "expr":    "count_over_time({service=\"audit-controller\", event=\"packet.anchor_failed\"}[$__range])",
          "legendFormat": "failures"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red",    "value": 5 }
            ]
          },
          "unit": "short"
        }
      },
      "options": { "reduceOptions": { "calcs": ["sum"] }, "textMode": "value_and_name" }
    },

    {
      "id": 13,
      "title": "Blockchain TX Latency (Jaeger)",
      "type": "table",
      "gridPos": { "x": 14, "y": 14, "w": 10, "h": 5 },
      "datasource": { "type": "jaeger", "uid": "${DS_JAEGER}" },
      "targets": [
        {
          "queryType": "search",
          "service":   "watcher",
          "operation": "blockchain.sendTx",
          "limit":     20
        }
      ],
      "options": { "frameIndex": 0 }
    },

    {
      "id": 20,
      "type": "row",
      "title": "System Latency",
      "gridPos": { "x": 0, "y": 19, "w": 24, "h": 1 },
      "collapsed": false
    },

    {
      "id": 21,
      "title": "IPFS Upload Latency (p50 / p95)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr":         "histogram_quantile(0.50, rate(watcher_blob_upload_duration_ms_bucket[2m]))",
          "legendFormat": "p50"
        },
        {
          "expr":         "histogram_quantile(0.95, rate(watcher_blob_upload_duration_ms_bucket[2m]))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "lineWidth": 2 } }
      }
    },

    {
      "id": 22,
      "title": "Packet Dispatch Latency (p50 / p95)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr":         "histogram_quantile(0.50, rate(watcher_dispatch_duration_ms_bucket[2m]))",
          "legendFormat": "p50"
        },
        {
          "expr":         "histogram_quantile(0.95, rate(watcher_dispatch_duration_ms_bucket[2m]))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "lineWidth": 2 } }
      }
    },

    {
      "id": 23,
      "type": "row",
      "title": "Audit Controller Health",
      "gridPos": { "x": 0, "y": 27, "w": 24, "h": 1 },
      "collapsed": false
    },

    {
      "id": 24,
      "title": "HTTP Request Latency (p50 / p95)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr":         "histogram_quantile(0.50, rate(http_server_duration_milliseconds_bucket[2m]))",
          "legendFormat": "p50"
        },
        {
          "expr":         "histogram_quantile(0.95, rate(http_server_duration_milliseconds_bucket[2m]))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "lineWidth": 2 },
          "thresholds": {
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 500 },
              { "color": "red",    "value": 2000 }
            ]
          }
        }
      }
    },

    {
      "id": 25,
      "title": "Node.js Event Loop Delay p99",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 28, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr":         "nodejs_eventloop_delay_p99_seconds * 1000",
          "legendFormat": "p99 delay"
        },
        {
          "expr":         "nodejs_eventloop_delay_p50_seconds * 1000",
          "legendFormat": "p50 delay"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "thresholds": {
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red",    "value": 500 }
            ]
          }
        }
      }
    },

    {
      "id": 26,
      "title": "OTel Span Queue Size",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 35, "w": 8, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr":         "otel_sdk_processor_span_queue_size",
          "legendFormat": "span queue"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2 },
          "thresholds": {
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red",    "value": 500 }
            ]
          }
        }
      }
    },

    {
      "id": 27,
      "title": "OTel Spans Processed Total",
      "type": "stat",
      "gridPos": { "x": 8, "y": 35, "w": 8, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr":         "otel_sdk_processor_span_processed_total",
          "legendFormat": "spans"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value_and_name" }
    },

    {
      "id": 28,
      "title": "V8 Heap Used",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 35, "w": 8, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr":         "v8js_memory_heap_used_bytes",
          "legendFormat": "heap used"
        },
        {
          "expr":         "v8js_memory_heap_limit_bytes",
          "legendFormat": "heap limit"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    },

    {
      "id": 30,
      "type": "row",
      "title": "Logs",
      "gridPos": { "x": 0, "y": 40, "w": 24, "h": 1 },
      "collapsed": false
    },

    {
      "id": 31,
      "title": "Watcher Events",
      "type": "logs",
      "gridPos": { "x": 0, "y": 41, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "expr": "{service=\"watcher\", session_id=~\"$session_id\"}",
          "maxLines": 100
        }
      ],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" }
    },

    {
      "id": 32,
      "title": "Audit Controller Errors",
      "type": "logs",
      "gridPos": { "x": 12, "y": 41, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "expr": "{service=\"audit-controller\"} | json | level=\"error\"",
          "maxLines": 100
        }
      ],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" }
    }

  ]
}